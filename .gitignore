# Local builds and test output
**/bin/
**/obj/
**/__pycache__/
.venv/
logs/
.asset-cache/
mod/*/TestResults/
# Game assemblies and generated binaries are not distributed
*.dll
*.pdb
*.exe
# Third-party artwork and downloaded page caches stay local
*.png
*.webp
*.jpg
*.jpeg
*.html
# Curated README screenshots; other artwork and test captures stay local.
!/docs/images/characters.jpg
!/docs/images/card-packs.png
!/docs/images/appearance-picker.png
**/preview-catalog.json
**/cards-zh-catalog.json
# Machine-local configuration
.env
.env.*
!.env.example
.DS_Store
# Unused upstream website extraction scripts are local research caches
/data/sources/**/*.js

# Complete local release archives
/dist/
