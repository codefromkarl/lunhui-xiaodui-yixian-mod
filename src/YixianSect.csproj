<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>0.7.3</Version>
    <AssemblyName>YixianSect</AssemblyName>
    <RootNamespace>YixianSect</RootNamespace>
    <LangVersion>9</LangVersion>
    <Nullable>disable</Nullable>
    <OutputPath>../mod/yixian.sect/plugins/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Reincarnation.Gameplay" HintPath="$(GameManaged)/Reincarnation.Gameplay.dll" Private="false" />
    <Reference Include="Reincarnation.Presentation" HintPath="$(GameManaged)/Reincarnation.Presentation.dll" Private="false" />
    <Reference Include="Reincarnation.Network" HintPath="$(GameManaged)/Reincarnation.Network.dll" Private="false" />
    <Reference Include="Mirror" HintPath="$(GameManaged)/Mirror.dll" Private="false" />
    <Reference Include="Reincarnation.Domain" HintPath="$(GameManaged)\Reincarnation.Domain.dll" Private="false" />
    <Reference Include="Reincarnation.Config" HintPath="$(GameManaged)\Reincarnation.Config.dll" Private="false" />
    <Reference Include="Reincarnation.Runtime" HintPath="$(GameManaged)\Reincarnation.Runtime.dll" Private="false" />
    <Reference Include="Reincarnation.UI" HintPath="$(GameManaged)\Reincarnation.UI.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(GameManaged)\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(GameManaged)\0Harmony.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(GameManaged)\UnityEngine.UI.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(GameManaged)\Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="UnityEngine.UIModule" HintPath="$(GameManaged)\UnityEngine.UIModule.dll" Private="false" />
    <Reference Include="UnityEngine.ImageConversionModule" HintPath="$(GameManaged)\UnityEngine.ImageConversionModule.dll" Private="false" />
    <Reference Include="ThryuFrameworkPro" HintPath="$(GameManaged)\ThryuFrameworkPro.dll" Private="false" />
    <Reference Include="Newtonsoft.Json" HintPath="$(GameManaged)\Newtonsoft.Json.dll" Private="false" />
  </ItemGroup>
  <Target Name="CheckGameManaged" BeforeTargets="ResolveAssemblyReferences" Condition="!Exists('$(GameManaged)\Reincarnation.Domain.dll')">
    <Error Text="找不到游戏程序集。用 -p:GameManaged=&quot;&lt;游戏&gt;\ReincarnationSquad_Data\Managed&quot; 指定。" />
  </Target>
</Project>
